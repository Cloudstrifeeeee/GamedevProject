        current_hp += heal

        # prevent overhealing
        if current_hp > player["hp"]:
            current_hp = player["hp"]

        print(f"You dealt {damage} damage!")
        print(f"You recovered {heal} HP!")



    # prevent monster HP from becoming negative
    if monster_hp < 0:
        monster_hp = 0

    # return updated monster HP
    return monster_hp


# MAIN FIGHT SYSTEM
# Handles the battle between player and monster
def fight(monster_name, hp, atk, exp_reward, gold_reward):

    # allows this function to modify global variables
    global current_hp, exp, hero_gold, level

    # set monster HP for this battle
    monster_hp = hp

    # encounter message
    print(f"\n{R}⚔️  ENCOUNTER: {monster_name.upper()}! ⚔️{RESET}")

    # battle loop
    # continues until either the monster or player dies
    while monster_hp > 0 and current_hp > 0:

        # =========================
        # PLAYER TURN
        # =========================
    
        print(f"\n{G}❤️  Your HP: {current_hp}/{player['hp']}{RESET}")
        print(f"{R}👾 {monster_name} HP: {monster_hp}{RESET}")

        # display combat choices
        print("\nChoose action:")
        print(f"{W}(1) Attack{RESET}")
        print(f"{W}(2) Skill{RESET}")
        print(f"{W}(3) Run{RESET}")

        # ask player for combat input
        combat_choice = input("> ")

        # NORMAL ATTACK
        if combat_choice == "1":

            # call attack function
            # reduces monster HP using player attack stat
            monster_hp = attack_monster(
                monster_hp,
                player["attack"]
            )

        # SKILL ATTACK
        elif combat_choice == "2":

            # use class special skill
            monster_hp = use_skill(
                monster_hp,
                atk
            )

        elif combat_choice == "3":
            if random.random() < 0.5:
                print("\nYou escaped successfully!")
                return True
            
                
        # INVALID INPUT
        else:

            # prevent invalid actions
            print("Invalid action!")

            # restart current loop iteration
            continue

        # show remaining monster HP
        print(f"{monster_name} HP: {monster_hp}")



        # =========================
        # CHECK IF MONSTER DIED
        # =========================

        if monster_hp <= 0:

            # victory message
            print(f"\n{G}🏆 VICTORY!{RESET}")
            print(f"You defeated the {monster_name}!")

            # reward player
            exp += exp_reward
            hero_gold += gold_reward

            # display rewards
            print(f"{Y}💰 Gained {exp_reward} EXP and {gold_reward} gold!{RESET}")

            # checks the level up progress
            if exp >= level * 120:
                level += 1
                player['hp'] += 15
                player['attack'] += 5
                player['defense'] += 3
                current_hp = player['hp']
                print(f"\n{C}⚡⚡ LEVEL UP! NOW LEVEL {level} ⚡⚡{RESET}")
                print(f"{G}HP +15 | {R}Attack +5 | {B}Defense +3{RESET}")
            return True



        # =========================
        # MONSTER TURN
        # =========================

        # monster attacks player
        current_hp = attack_player(
            current_hp,
            atk,
            player["defense"]
        )

        # display updated player HP
        print(f"Your HP: {current_hp}")

        



        # =========================
        # CHECK IF PLAYER DIED
        # =========================

        if current_hp <= 0:

            # death message
            print(f"\n{R}You died...{RESET}")

            # player loses battle
            return False

