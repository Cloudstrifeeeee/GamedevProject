def venture():
    events=[
        ("A monster have appeared!", 44), 
        ("A merchant appeared!", 20),
        ("You found something useful!", 15),
        ("You triggered a trap!", 15),
        ("An ominous enemy have appeared", 5),
        ("You found what seem to be an exit!", 1)
    ]#the event tupples, yall can add more here 
    
    roll = random.randint(1, 100)
    total = 0
    
    for event, chance in events: #unpacking the events tupples
        total += chance #increase a chance of an event to be triggered
        if roll <= total: # this line check if the random int falls within the range of an event
            # apply color for display, but return clean string for if-checks
            if "monster" in event:
                print(f"\n{R}{event}{RESET}")
                return "A monster have appeared!"
            if "merchant" in event:
                print(f"\n{Y}{event}{RESET}")
                return "A merchant appeared!"
            if "useful" in event:
                print(f"\n{G}{event}{RESET}")
                return "You found something useful!"
            if "trap" in event:
                print(f"\n{W}{event}{RESET}")
                return "You triggered a trap!"
            if "ominous" in event:
                print(f"\n{R}{B}{event}{RESET}")
                return "An ominous enemy have appeared"
            if "exit" in event:
                print(f"\n{C}{event}{RESET}")
                return "You found what seem to be an exit!"
    
    return "nothing"


